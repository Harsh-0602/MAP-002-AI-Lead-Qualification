    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $json.content.parts[0].text;\n\nconst cleaned = text\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet result;\nlet isValid = true;\n\ntry {\n  result = JSON.parse(cleaned);\n  \n  // Basic shape validation\n  const validCategories = [\"Hot\", \"Warm\", \"Cold\"];\n  if (\n    typeof result.lead_score !== \"number\" ||\n    !validCategories.includes(result.category)\n  ) {\n    isValid = false;\n  }\n} catch (e) {\n  isValid = false;\n  result = { raw_output: cleaned };\n}\n\nreturn {\n  json: {\n    ...result,\n    is_valid: isValid\n  }\n};"
      },
