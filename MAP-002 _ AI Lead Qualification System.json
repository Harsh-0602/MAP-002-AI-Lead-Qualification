        "messages": {
          "values": [
            {
              "content": "You are an expert B2B SaaS sales assistant.\n\nAnalyze the lead and return ONLY valid JSON.\n\nScoring Rules:\n\n90-100 = Hot Lead\n70-89 = Warm Lead\n0-69 = Cold Lead\n\nConsider:\n- Company size\n- Budget\n- Buying intent\n- Urgency\n- Business relevance\n\nReturn ONLY this JSON:\n\n{\n  \"lead_score\": number,\n  \"category\": \"Hot/Warm/Cold\",\n  \"priority\": \"High/Medium/Low\",\n  \"reason\": \"Short explanation\"\n}",
              "role": "model"
            },
            {
              "content": "=Name:\n{{ $('Generate Lead Key').item.json.body.name }}\n\nEmail:\n{{ $('Generate Lead Key').item.json.body.email }}\n\nCompany:\n{{ $('Generate Lead Key').item.json.body.company }}\n\nEmployees:\n{{ $('Generate Lead Key').item.json.body.employees }}\n\nBudget:\n{{ $('Generate Lead Key').item.json.body.budget }}\n\nRequirement:\n{{ $('Generate Lead Key').item.json.body.requirement }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
