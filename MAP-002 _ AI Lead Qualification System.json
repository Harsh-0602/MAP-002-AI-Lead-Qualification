    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body;\n\n// Stable key banate hain email + company + requirement se\n// Isse exact duplicate submissions (retries) catch honge,\n// lekin same person ki genuinely nayi inquiry allow hogi\nconst rawKey = `${body.email}-${body.company}-${body.requirement}`.toLowerCase().trim();\n\n// Simple hash function (crypto module ke bina) - djb2 algorithm\nfunction simpleHash(str) {\n  let hash = 5381;\n  for (let i = 0; i < str.length; i++) {\n    hash = ((hash << 5) + hash) + str.charCodeAt(i);\n    hash = hash & hash; // Convert to 32-bit integer\n  }\n  return Math.abs(hash).toString(16);\n}\n\nconst leadKey = simpleHash(rawKey);\n\nreturn {\n  json: {\n    ...$json,\n    leadKey: leadKey\n  }\n};"
      },
